# Server Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Frontend / Allowed CORS Origins (comma-separated)
CORS_ORIGINS=https://ithihasa.com,https://admin.ithihasa.com,capacitor://localhost,http://localhost:5173,http://localhost:5174

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:password@localhost:5432/ithihasa_db
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE=10000

# Authentication & JWT Secrets (generate secure 256-bit keys)
JWT_SECRET=change_this_to_a_secure_jwt_secret_key
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change_this_to_a_secure_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Google OAuth / Firebase
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# WhatsApp OTP Service (mock or official meta graph api)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=3

# PhonePe Payment Gateway (SANDBOX or PRODUCTION)
PHONEPE_ENV=SANDBOX
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_CALLBACK_URL=https://api.ithihasa.com/api/v1/payments/phonepe/webhook
PHONEPE_REDIRECT_URL=https://ithihasa.com/checkout/confirmation

# Pricing & Tax Configuration
CURRENCY=INR
TAX_RATE=0.00
DEFAULT_SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=0

# Admin Seed Configuration (Optional for initial bootstrap)
ADMIN_EMAIL=admin@ithihasa.com
ADMIN_INITIAL_PASSWORD=ChangeThisAdminPassword!123
