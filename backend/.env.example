# ==============================================================================
# Ithihasa Atelier E-Commerce Platform — Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,capacitor://localhost,http://localhost

# Database Connection (PostgreSQL 14+)
DATABASE_URL=postgres://postgres:admin123@localhost:5432/ithihasa_db
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE=10000

# JSON Web Token (JWT) Secrets (Generate cryptographic 256-bit strings for production)
JWT_SECRET=ithihasa_super_secret_jwt_key_dev_2026_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=ithihasa_super_refresh_secret_key_dev_2026_change_in_production
REFRESH_TOKEN_EXPIRES_IN=30d

# Google OAuth Client (Optional for dev, required for Google SSO)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# WhatsApp OTP Delivery ('mock' | 'meta' | 'twilio')
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=your_meta_or_twilio_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=3

# PhonePe Payment Gateway (SANDBOX or PRODUCTION)
PHONEPE_ENV=SANDBOX
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_CALLBACK_URL=http://localhost:5000/api/v1/payments/phonepe/webhook
PHONEPE_REDIRECT_URL=http://localhost:5173/checkout/confirmation

# Currency & Commerce Tax Configuration
CURRENCY=INR
TAX_RATE=0.00
DEFAULT_SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=0
